generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Simplified Exercise Model
model Exercise {
  id              Int                     @id @default(autoincrement())
  name            String                  @unique
  slug            String                  @unique
  description     String?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  status          ExerciseStatus          @default(ACTIVE)
  difficulty      Difficulty              @default(Beginner)
  targetedMuscles TargetedMuscle[]        @relation("ExerciseToMuscle")
  muscleGroups    MuscleGroup[]           @relation("ExerciseToGroup")
  equipment       Equipment[]             @relation("ExerciseToEquipment")
  instructions    ExerciseInstruction[]
  featured        FeaturedExercise?
}

enum ExerciseStatus {
  ACTIVE
  FEATURED
  ARCHIVED
}

enum Difficulty {
  Beginner
  Intermediate
  Advanced
}

model FeaturedExercise {
  id         Int      @id @default(autoincrement())
  exerciseId Int      @unique
  exercise   Exercise @relation(fields: [exerciseId], references: [id])
  featuredAt DateTime @default(now()) // Optional: Track when it was featured
}

// Muscle Group Model
model MuscleGroup {
  id          Int         @id @default(autoincrement())
  name        String      @unique
  description String?
  exercises   Exercise[]  @relation("ExerciseToGroup")
}

// Targeted Muscle Model
model TargetedMuscle {
  id          Int         @id @default(autoincrement())
  name        String      @unique
  exercises   Exercise[]  @relation("ExerciseToMuscle")
}

// Equipment Model
model Equipment {
  id          Int         @id @default(autoincrement())
  name        String      @unique
  description String?
  exercises   Exercise[]  @relation("ExerciseToEquipment")
}

// Exercise Instructions
model ExerciseInstruction {
  id          Int      @id @default(autoincrement())
  exerciseId  Int
  instruction String
  exercise    Exercise @relation(fields: [exerciseId], references: [id])
}
